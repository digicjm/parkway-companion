		"power": {
			"id": "power",
			"label": "Quick Start",
			"icon": "shutdown",
			"onPress": {
				"var": "showModal",
				"value": "quickStartMenu"
			}
		},
		"startSunClass": {
			"id": "startSunClass",
			"label": "Sunday Class",
			"icon": "classroom",
			"onPress": {
				"var": "quickStart",
				"value": "sunClass"
			}
		},
		"startSunService": {
			"id": "startSunService",
			"label": "Sunday Service",
			"icon": "cross",
			"onPress": {
				"var": "quickStart",
				"value": "sunService"
			}
		},
		"startWedClass": {
			"id": "startWedClass",
			"label": "Wed Night Class",
			"icon": "holy-bible",
			"onPress": {
				"var": "quickStart",
				"value": "wedClass"
			}
		},
		"presetCross": {
			"id": "presetCross",
			"label": "Cross",
			"icon": "cross",
			"onPress": {
				"var": "recallPreset",
				"value": "cross"
			}
		},
		"presetClass": {
			"id": "presetClass",
			"label": "Class",
			"icon": "classroom",
			"onPress": {
				"var": "recallPreset",
				"value": "class"
			}
		},
		"presetTimer": {
			"id": "presetTimer",
			"label": "Timer",
			"icon": "digital-clock",
			"onPress": {
				"var": "recallPreset",
				"value": "timer"
			}
		},
		"presetPodium": {
			"id": "presetPodium",
			"label": "Podium",
			"icon": "podium-with-speaker",
			"onPress": {
				"var": "recallPreset",
				"value": "podium"
			}
		},
		"presetSinging": {
			"id": "presetSinging",
			"label": "Singing",
			"icon": "music-transcript",
			"onPress": {
				"var": "recallPreset",
				"value": "singing"
			}
		},
		"presetCommunion": {
			"id": "presetCommunion",
			"label": "Communion",
			"icon": "grapes",
			"onPress": {
				"var": "recallPreset",
				"value": "communion"
			}
		},
		"presetChildren": {
			"id": "presetChildren",
			"label": "Children",
			"icon": "children",
			"onPress": {
				"var": "recallPreset",
				"value": "children"
			}
		},
		"presetSermon": {
			"id": "presetSermon",
			"label": "Sermon",
			"icon": "headset",
			"onPress": {
				"var": "recallPreset",
				"value": "sermon"
			}
		},
		"fbLive": {
			"id": "fbLive",
			"customStyle": "0/0",
			"onPress": {
				"var": "startStream"
			}
		},
		"webExCallToggle": {
			"id": "webExCallToggle",
			"label": "Start WebEx",
			"icon": "phone-disconnected",
			"onPress": {
				"var": "startStopWebEx"
			}
		},
		"recordToggle": {
			"id": "recordToggle",
			"label": "Start Recording",
			"icon": "usb-memory-stick",
			"onPress": {
				"var": "startStopRecording"
			}
		},
		"programSourceSelect": {
			"id": "programSourceSelect",
			"label": "Program: ${$(expression:streamVideo).program.source.label}",
			"icon": "tv-show",
			"onPress": {
				"var": "showModal",
				"value": "programSourceQuickSelect"
			}
		},
		"pip": {
			"id": "pip",
			"label": "PIP: ${$(expression:streamVideo).pip.source.label}",
			"icon": "channel-mosaic",
			"onPress": {
				"var": "showModal",
				"value": "pipQuickSelect"
			}
		},
		"hideLogo": {
			"id": "hideLogo",
			"label": "Hide Logo",
			"icon": "no-image",
			"highlight": "red",
			"onPress": {
				"var": "toggleHideLogo"
			}
		},
		"showMessage": {
			"id": "showMessage",
			"label": "Show Message",
			"icon": "speech-bubble-with-dots",
			"onPress": {
				"var": "showModal",
				"value": "messageSelect"
			}
		},
		"muteVideo": {
			"id": "muteVideo",
			"label": "Mute Video",
			"icon": "no-video",
			"highlight": "red",
			"onPress": {
				"var": "toggleMuteVideo"
			}
		},
		"cameraUp": {
			"id": "cameraUp",
			"label": "UP",
			"icon": "chevron-up",
			"onPress": {
				"var": "setPtz.up",
				"value": true
			},
			"onRelease": {
				"var": "setPtz.up",
				"value": false
			}
		},
		"cameraDown": {
			"id": "cameraDown",
			"label": "DOWN",
			"icon": "chevron-down",
			"onPress": {
				"var": "setPtz.down",
				"value": true
			},
			"onRelease": {
				"var": "setPtz.down",
				"value": false
			}
		},
		"cameraLeft": {
			"id": "cameraLeft",
			"label": "LEFT",
			"icon": "chevron-left",
			"onPress": {
				"var": "setPtz.left",
				"value": true
			},
			"onRelease": {
				"var": "setPtz.left",
				"value": false
			}
		},
		"cameraRight": {
			"id": "cameraRight",
			"label": "RIGHT",
			"icon": "chevron-right",
			"onPress": {
				"var": "setPtz.right",
				"value": true
			},
			"onRelease": {
				"var": "setPtz.right",
				"value": false
			}
		},
		"cameraZoomIn": {
			"id": "cameraZoomIn",
			"label": "ZOOM IN",
			"icon": "zoom-in",
			"onPress": {
				"var": "setPtz.in",
				"value": true
			},
			"onRelease": {
				"var": "setPtz.in",
				"value": false
			}
		},
		"cameraZoomOut": {
			"id": "cameraZoomOut",
			"label": "ZOOM OUT",
			"icon": "zoom-out",
			"onPress": {
				"var": "setPtz.out",
				"value": true
			},
			"onRelease": {
				"var": "setPtz.out",
				"value": false
			}
		},
		"cameraHome": {
			"id": "cameraHome",
			"label": "RESET",
			"icon": "center-direction",
			"onPress": {
				"var": "resetPtz"
			}
		},
		"cameraToggle": {
			"id": "cameraToggle",
			"label": "Toggle Cam",
			"icon": "video-call",
			"onPress": {
				"var": "setPtz.altCam",
				"toggle": true
			}
		},
		"cameraPresets": {
			"id": "cameraPresets",
			"label": "Presets",
			"icon": "bulleted-list",
			"onPress": {
				"var": "showModal",
				"value": "cameraPresets"
			}
		},
		"streamMicMute": {
			"id": "streamMicMute",
			"label": "Mute Stream",
			"icon": "no-microphone",
			"selected": "$(custom:muteStreamMic).value",
			"highlight": "red",
			"onPress": {
				"var": "muteStreamMic",
				"toggle": true
			}
		},
		"farEndMute": {
			"id": "farEndMute",
			"label": "Mute Callers",
			"icon": "no-audio",
			"selected": "$(custom:muteFarEnd).value",
			"highlight": "red",
			"onPress": {
				"var": "muteFarEnd",
				"toggle": true
			}
		},
		"reinforcementMute": {
			"id": "reinforcementMute",
			"label": "Stop Voice Amplification",
			"icon": "not-hearing",
			"selected": "$(custom:muteReinforcement).value",
			"highlight": "red",
			"onPress": {
				"var": "muteReinforcement",
				"toggle": true
			}
		},
		"turnOffAllAudio": {
			"id": "turnOffAllAudio",
			"label": "Turn Off All Audio",
			"icon": "block-microphone",
			"onPress": {
				"var": "turnOffAllAudio"
			}
		},
		"resetAudioLevels": {
			"id": "resetAudioLevels",
			"label": "Reset Levels",
			"icon": "vertical-settings-mixer",
			"onPress": {
				"var": "resetAudioLevels"
			}
		},
		"headphoneSource": {
			"id": "headphoneSource",
			"label": "Headphone Source",
			"icon": "headphones",
			"onPress": {
				"var": "showModal",
				"value": "headphoneSourceSelect"
			}
		},
		"videoRoutingBoothMon": {
			"id": "videoRoutingBoothMon",
			"label": "Booth Mon: ${$(expression:videoRouting).boothMon.source.label}",
			"icon": "imac-settings",
			"onTap": {
				"var": "showModal",
				"value": "boothMonQuickSelect"
			},
			"onHold": {
				"var": "goToPage",
				"value": "videoRouting"
			}
		},
		"videoRoutingChurchFront": {
			"id": "videoRoutingChurchFront",
			"label": "Front TVs: ${$(expression:videoRouting).churchFront.source.label}",
			"icon": "screensharing",
			"onTap": {
				"var": "showModal",
				"value": "churchFrontQuickSelect"
			},
			"onHold": {
				"var": "goToPage",
				"value": "videoRouting"
			}
		},
		"videoRoutingChurchRear": {
			"id": "videoRoutingChurchRear",
			"label": "Rear TV: ${$(expression:videoRouting).churchRear.source.label}",
			"icon": "under-computer",
			"onTap": {
				"var": "showModal",
				"value": "churchRearQuickSelect"
			},
			"onHold": {
				"var": "goToPage",
				"value": "videoRouting"
			}
		},
		"videoRoutingNursery": {
			"id": "videoRoutingNursery",
			"label": "Nursery TV: ${$(expression:videoRouting).nursery.source.label}",
			"icon": "mothers-health",
			"onTap": {
				"var": "showModal",
				"value": "nurseryQuickSelect"
			},
			"onHold": {
				"var": "goToPage",
				"value": "videoRouting"
			}
		},
		"videoSourceSelectPCSlides": {
			"id": "videoSourceSelectPCSlides",
			"label": "PC/Slides",
			"icon": "workstation",
			"select": "pc",
			"onPress": {
				"var": "selectVideoRoutingSource",
				"value": {
					"display": "$(local:groupTag)",
					"source": "pc"
				}
			}
		},
		"videoSourceSelectProgram": {
			"id": "videoSourceSelectProgram",
			"label": "Broadcast",
			"icon": "gps-receiving",
			"select": "program",
			"onPress": {
				"var": "selectVideoRoutingSource",
				"value": {
					"display": "$(local:groupTag)",
					"source": "program"
				}
			}
		},
		"videoSourceSelectWebEx": {
			"id": "videoSourceSelectWebEx",
			"label": "WebEx Call",
			"icon": "webcam-man",
			"select": "webex",
			"onPress": {
				"var": "selectVideoRoutingSource",
				"value": {
					"display": "$(local:groupTag)",
					"source": "webex"
				}
			}
		},
		"videoSourceSelectMessage": {
			"id": "videoSourceSelectMessage",
			"label": "Message",
			"icon": "speech-bubble-with-dots",
			"select": "message",
			"onPress": {
				"var": "selectVideoRoutingSource",
				"value": {
					"display": "$(local:groupTag)",
					"source": "message"
				}
			}
		},
		"streamSourceSelectPCSlides": {
			"id": "streamSourceSelectPCSlides",
			"label": "PC/Slides",
			"icon": "workstation",
			"select": "pc",
			"onPress": {
				"var": "selectStreamSource",
				"value": {
					"output": "$(local:groupTag)",
					"source": "pc"
				}
			}
		},
		"streamSourceSelectCam1": {
			"id": "streamSourceSelectCam1",
			"label": "Rear Cam",
			"icon": "video-call",
			"select": "cam1",
			"onPress": {
				"var": "selectStreamSource",
				"value": {
					"output": "$(local:groupTag)",
					"source": "cam1"
				}
			}
		},
		"streamSourceSelectCam2": {
			"id": "streamSourceSelectCam2",
			"label": "Side Cam",
			"icon": "video-call",
			"select": "cam2",
			"onPress": {
				"var": "selectStreamSource",
				"value": {
					"output": "$(local:groupTag)",
					"source": "cam2"
				}
			}
		},
		"streamSourceSelectAux": {
			"id": "streamSourceSelectAux",
			"label": "Aux / Laptop",
			"icon": "network-cable",
			"select": "aux",
			"onPress": {
				"var": "selectStreamSource",
				"value": {
					"output": "$(local:groupTag)",
					"source": "aux"
				}
			}
		}
	},
	"buttonGroups": {
		"system": {
			"id": "system",
			"background": "red",
			"buttons": [
				[
					"power"
				]
			]
		},
		"quickStartMenu": {
			"id": "quickStartMenu",
			"background": "red",
			"buttons": [
				[
					"cancelModal"
				],
				[
					"startSunClass"
				],
				[
					"startSunService"
				],
				[
					"startWedClass"
				]
			]
		},
		"presets": {
			"id": "presets",
			"background": "teal",
			"buttons": [
				[
					"presetCross",
					"presetClass",
					"presetTimer",
					"presetPodium",
					"presetSinging",
					"presetCommunion",
					"presetChildren",
					"presetSermon"
				]
			]
		},
		"stream": {
			"id": "stream",
			"background": "blue",
			"buttons": [
				[
					"fbLive",
					"webExCallToggle",
					"recordToggle",
					"programSourceSelect"
				],
				[
					"muteVideo",
					"hideLogo",
					"showMessage",
					"pip"
				]
			]
		},
		"streamSources": {
			"id": "streamSources",
			"background": "blue",
			"buttons": [
				[
					"streamSourceSelectCam1",
					"streamSourceSelectCam2",
					"streamSourceSelectPCSlides",
					"streamSourceSelectAux"
				]
			]
		},
		"audio": {
			"id": "audio",
			"background": "green",
			"buttons": [
				[
					"streamMicMute",
					"farEndMute",
					"reinforcementMute",
					"turnOffAllAudio",
					"resetAudioLevels",
					"headphoneSource"
				]
			]
		},
		"camera": {
			"id": "camera",
			"background": "purple",
			"buttons": [
				[
					"cameraToggle",
					"cameraUp",
					"cameraZoomIn"
				],
				[
					"cameraLeft",
					"cameraHome",
					"cameraRight"
				],
				[
					"cameraPresets",
					"cameraDown",
					"cameraZoomOut"
				]
			]
		},
		"videoRouting": {
			"id": "videoRouting",
			"background": "pink",
			"buttons": [
				[
					"videoRoutingChurchFront",
					"videoRoutingBoothMon"
				],
				[
					"videoRoutingChurchRear",
					"videoRoutingNursery"
				]
			]
		},
		"videoRoutingSources": {
			"id": "videoRoutingSources",
			"background": "pink",
			"buttons": [
				[
					"videoSourceSelectProgram",
					"videoSourceSelectPCSlides"
				],
				[
					"videoSourceSelectWebEx",
					"videoSourceSelectMessage"
				]
			]
		},
		"headphoneSources": {
			"id": "headphoneSources",
			"background": "blue",
			"buttons": [
				[
					"cancelModal"
				]
			]
		}
	},
	"pages": {
		"main": {
			"id": "main",
			"groups": [
				{
					"id": "system",
					"row": 0,
					"col": 0
				},
				{
					"id": "presets",
					"row": 0,
					"col": 1
				},
				{
					"id": "stream",
					"row": 1,
					"col": 0
				},
				{
					"id": "videoRouting",
					"row": 1,
					"col": 4
				},
				{
					"id": "camera",
					"row": 1,
					"col": 6
				},
				{
					"id": "audio",
					"row": 3,
					"col": 0
				}
			]
		},
		"quickStartMenu": {
			"id": "quickStartMenu",
			"groups": [
				{
					"id": "quickStartMenu",
					"closeModalOnSelect": true,
					"row": 0,
					"col": 0
				}
			]
		},
		"boothMonQuickSelect": {
			"id": "boothMonQuickSelect",
			"groups": [
				{
					"id": "videoRoutingSources",
					"tag": "boothMon",
					"selection": "$(expression:videoRouting).boothMon.source.id",
					"closeModalOnSelect": true,
					"row": 1,
					"col": 4
				}
			]
		},
		"churchFrontQuickSelect": {
			"id": "churchFrontQuickSelect",
			"groups": [
				{
					"id": "videoRoutingSources",
					"tag": "churchFront",
					"selection": "$(expression:videoRouting).churchFront.source.id",
					"closeModalOnSelect": true,
					"row": 1,
					"col": 4
				}
			]
		},
		"churchRearQuickSelect": {
			"id": "churchRearQuickSelect",
			"groups": [
				{
					"id": "videoRoutingSources",
					"tag": "churchRear",
					"selection": "$(expression:videoRouting).churchRear.source.id",
					"closeModalOnSelect": true,
					"row": 1,
					"col": 4
				}
			]
		},
		"nurseryQuickSelect": {
			"id": "nurseryQuickSelect",
			"groups": [
				{
					"id": "videoRoutingSources",
					"tag": "nursery",
					"selection": "$(expression:videoRouting).nursery.source.id",
					"closeModalOnSelect": true,
					"row": 1,
					"col": 4
				}
			]
		},
		"programSourceQuickSelect": {
			"id": "programSourceQuickSelect",
			"groups": [
				{
					"id": "streamSources",
					"tag": "program",
					"selection": "$(expression:streamVideo).program.source.id",
					"closeModalOnSelect": true,
					"row": 1,
					"col": 4
				}
			]
		},
		"pipQuickSelect": {
			"id": "pipQuickSelect",
			"groups": [
				{
					"id": "streamSources",
					"tag": "pip",
					"selection": "$(expression:streamVideo).pip.source.id",
					"closeModalOnSelect": true,
					"row": 2,
					"col": 4
				}
			]
		},
		"headphoneSourceSelect": {
			"id": "headphoneSourceSelect",
			"groups": [
				{
					"id": "headphoneSources",
					"closeModalOnSelect": true,
					"row": 3,
					"col": 5
				}
			]
		}
	}
}